{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nws-weather",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs code; everything else is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "routes": [{ "pattern": "weather.peterkrieg.com", "custom_domain": true }]
}
